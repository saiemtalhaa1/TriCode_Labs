extends layout

block content
  section.section
    .container
      h1.page-title Edit Listing
      p.page-subtitle Update your listing details.

      if error
        .alert.alert-error= error

      .create-layout
        form.create-form(method="POST" action=`/listings/${listing.listing_id}/edit` enctype="multipart/form-data")
          .form-group
            label(for="title") Title
            input#title(type="text" name="title" value=listing.title required)

          .form-group
            label(for="description") Description
            textarea#description(name="description" rows="4" required)= listing.description

          .form-row
            .form-group.form-half
              label(for="size") Size
              select#size(name="size" required)
                each s in ['XS', 'S', 'M', 'L', 'XL', 'XXL', 'One Size', '8', '9']
                  option(value=s selected=(listing.size === s))= s
            .form-group.form-half
              label(for="listing_type") Listing Type
              .radio-group
                label.radio-label
                  input(type="radio" name="listing_type" value="Borrow" checked=(listing.listing_type === 'Borrow'))
                  span Borrow
                label.radio-label
                  input(type="radio" name="listing_type" value="Giveaway" checked=(listing.listing_type === 'Giveaway'))
                  span Giveaway

          .form-group
            label(for="image") Outfit Image
            if listing.image_url
              .current-image
                img.preview-img(src=listing.image_url alt=listing.title)
                p.form-hint Current image. Upload a new one to replace it.
            .file-upload
              input#image(type="file" name="image" accept="image/*")

          .form-group
            label(for="location") Location
            input#location(type="text" name="location" value=listing.location || '')

          .form-group
            label Categories / Tags
            .checkbox-group
              each tag in tags
                label.checkbox-label
                  input(type="checkbox" name="tags" value=tag.tag_id checked=selectedTagIds.includes(tag.tag_id))
                  span= tag.name

          .form-row
            .form-group.form-half
              label(for="start_date") Available From
              input#start_date(type="date" name="start_date" value=(slot && slot.start_date ? new Date(slot.start_date).toISOString().split('T')[0] : ''))
            .form-group.form-half
              label(for="end_date") Available Until
              input#end_date(type="date" name="end_date" value=(slot && slot.end_date ? new Date(slot.end_date).toISOString().split('T')[0] : ''))

          .form-group
            label.checkbox-label
              input(type="checkbox" name="allow_guests" value="1" checked=listing.allow_guest_requests)
              span Allow Guest Borrowers

          .form-actions
            button.btn.btn-primary(type="submit") Save Changes
            a.btn.btn-secondary(href=`/listings/${listing.listing_id}`) Cancel
