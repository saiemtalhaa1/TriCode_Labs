extends layout

block content
  section.section
    .container
      h1.page-title Lending Dashboard
      p.page-subtitle Manage incoming requests and active lends.

      .dashboard-grid.dashboard-3col
        //- Incoming Requests
        .dashboard-column
          h2.column-title Incoming Requests
          if incoming.length > 0
            each item in incoming
              .dash-card
                .dash-card-header
                  span.dash-item-title #{item.title} #{item.size}
                  span.dash-status.status-pending New
                .dash-card-body
                  p.dash-meta Borrower: #{item.borrower_name}
                  if item.borrow_rating
                    p.dash-meta Rating: #{item.borrow_rating.toFixed(1)} ★
                  p.dash-meta Dates: #{new Date(item.start_date).toLocaleDateString('en-GB')} - #{new Date(item.end_date).toLocaleDateString('en-GB')}
                .dash-card-actions
                  form.inline-form(method="POST" action=`/lend/${item.request_id}/approve`)
                    button.btn.btn-primary.btn-small(type="submit") Approve
                  form.inline-form(method="POST" action=`/lend/${item.request_id}/reject`)
                    button.btn.btn-danger.btn-small(type="submit") Reject
          else
            p.empty-text No incoming requests.

        //- Active Lends
        .dashboard-column
          h2.column-title Active Lends
          if activeLends.length > 0
            each item in activeLends
              .dash-card
                .dash-card-header
                  span.dash-item-title #{item.title} #{item.size}
                  span.dash-status.status-active= item.status
                .dash-card-body
                  p.dash-meta Borrower: #{item.borrower_name}
                  p.dash-meta Due: #{new Date(item.end_date).toLocaleDateString('en-GB')}
                .dash-card-actions
                  form(method="POST" action=`/lend/${item.request_id}/return`)
                    button.btn.btn-primary.btn-small(type="submit") Confirm Return
          else
            p.empty-text No active lends.

        //- Completed Lends
        .dashboard-column
          h2.column-title Completed Lends
          if completedLends.length > 0
            each item in completedLends
              .dash-card
                .dash-card-header
                  span.dash-item-title #{item.title} #{item.size}
                  span.dash-status.status-completed Completed
                .dash-card-body
                  p.dash-meta Borrower: #{item.borrower_name}
                  if item.borrow_rating
                    p.dash-meta Borrower Rating: #{item.borrow_rating.toFixed(1)} ★
          else
            p.empty-text No completed lends yet.
