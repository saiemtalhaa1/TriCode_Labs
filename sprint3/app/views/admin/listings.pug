extends ../layout

block content
  section.section
    .container
      .page-header-row
        div
          h1.page-title Manage Listings
          p.page-subtitle Moderate all outfit listings on the platform.
        a.btn.btn-secondary(href="/admin") Back to Dashboard

      .admin-table
        each listing in listings
          .admin-row
            .admin-row-main
              if listing.image_url
                img.admin-thumb(src=listing.image_url alt=listing.title)
              div
                span.admin-row-title #{listing.title} (#{listing.size})
                span.admin-row-meta By #{listing.owner_name} | #{listing.location} | #{listing.listing_type} | #{listing.request_count} requests | #{listing.review_count} reviews
                if listing.boost_active
                  span.boost-active-badge Boosted
            .admin-row-actions
              a.btn.btn-small(href=`/listings/${listing.listing_id}`) View
              form.inline-form(method="POST" action=`/admin/listings/${listing.listing_id}/remove` onsubmit="return confirm('Remove this listing? This will notify the owner.')")
                button.btn.btn-small.btn-danger(type="submit") Remove
