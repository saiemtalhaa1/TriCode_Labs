extends layout

block content
  section.section
    .container
      .notifications-layout
        .notifications-main
          h1.page-title Notifications &amp; Inbox

          if notifications.length > 0
            .notifications-list
              each notif in notifications
                .notif-card(class=notif.is_read ? '' : 'notif-unread')
                  .notif-dot(class=`dot-${notif.type.toLowerCase()}`)
                  .notif-content
                    p.notif-message= notif.message
                    span.notif-time= new Date(notif.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
                  .notif-type
                    span.notif-badge= notif.type
          else
            .empty-state
              h3 No notifications yet
              p Your notifications will appear here when you start borrowing and lending.

        .notifications-sidebar
          .sidebar-card
            h3 Your Rewards
            .reward-points= rewardPoints
            span.reward-label points
            a.btn.btn-primary.btn-small(href=`/users/${currentUser.user_id}`) View Profile

          .sidebar-card
            h3 Quick Actions
            a.btn.btn-secondary.btn-small.btn-block(href="/create-listing") Create Listing
            a.btn.btn-secondary.btn-small.btn-block(href="/dashboard/borrow") My Borrows
            a.btn.btn-secondary.btn-small.btn-block(href="/dashboard/lend") My Lends
