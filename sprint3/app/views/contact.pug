extends layout

block content
  section.section
    .container
      h1.page-title Contact Us
      p.page-subtitle We'd love to hear from you. Get in touch with the OutfitShare team.

      .contact-layout
        .contact-form-section
          h2 Send us a Message
          if success
            .alert.alert-success= success
          form.create-form(method="POST" action="/contact")
            .form-group
              label(for="contact_name") Your Name
              input#contact_name(type="text" name="name" placeholder="Full name" required)
            .form-group
              label(for="contact_email") Email Address
              input#contact_email(type="email" name="email" placeholder="your@email.com" required)
            .form-group
              label(for="subject") Subject
              select#subject(name="subject" required)
                option(value="") Select a topic...
                option(value="General") General Enquiry
                option(value="Bug") Report a Bug
                option(value="Feature") Feature Request
                option(value="Safety") Safety Concern
                option(value="Account") Account Issue
                option(value="Other") Other
            .form-group
              label(for="message") Message
              textarea#message(name="message" rows="5" placeholder="Tell us what's on your mind..." required)
            button.btn.btn-primary.btn-full(type="submit") Send Message

        .contact-info-section
          .contact-card
            h3 Other Ways to Reach Us
            .contact-item
              span.contact-label Email
              span.contact-value support@outfitshare.co.uk
            .contact-item
              span.contact-label Response Time
              span.contact-value Within 48 hours
            .contact-item
              span.contact-label Location
              span.contact-value University of Roehampton, London

          .contact-card
            h3 Frequently Asked Questions
            .faq-item
              h4 How do I borrow an outfit?
              p Browse listings, find one you like, select your dates within the availability window, and submit a request. The lender will approve or decline.
            .faq-item
              h4 Is it free to use?
              p Yes! OutfitShare is completely free. We use a reward points system to incentivise sharing, not money.
            .faq-item
              h4 How are disputes handled?
              p Contact our support team or use the admin reporting system. We review all reports within 48 hours.
            .faq-item
              h4 How do I earn reward points?
              p You earn 10 points for lending, 5 points for borrowing, and 15 points for giveaways. Points can be used to boost your listings.
