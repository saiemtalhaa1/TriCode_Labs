doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title || 'OutfitShare'
    link(rel="stylesheet" href="/css/style.css")
  body
    nav.navbar
      .nav-container
        a.nav-logo(href="/") OutfitShare
        .nav-links
          a(href="/") Home
          a(href="/listings") Browse
          a(href="/categories") Categories
          a(href="/users") Community
        a.nav-btn(href="#") Login
    main.main-content
      block content
    footer.footer
      .footer-container
        .footer-section
          h3 OutfitShare
          p A community-driven platform for sharing outfits sustainably.
        .footer-section
          h3 Quick Links
          a(href="/listings") Browse Outfits
          a(href="/categories") Categories
          a(href="/users") Community
        .footer-section
          h3 About
          a(href="#") About Us
          a(href="#") Contact
          a(href="#") Terms of Use
      .footer-bottom
        p &copy; 2026 OutfitShare | TriCode Labs | University of Roehampton
