extends layout

block content
  section.section
    .container
      h1.page-title Edit Profile
      p.page-subtitle Update your personal information.

      if error
        .alert.alert-error= error
      if success
        .alert.alert-success= success

      .create-layout
        form.create-form(method="POST" action="/edit-profile" enctype="multipart/form-data")
          //- Profile Picture
          .form-group
            label Profile Picture
            .profile-pic-upload
              if user.profile_image
                img.preview-img.preview-round(src=user.profile_image alt=user.name)
              else
                .avatar-placeholder.avatar-large= user.name.charAt(0)
              .file-upload
                input(type="file" name="profile_image" accept="image/*")
                p.form-hint Upload a profile photo (max 5MB)

          h3.form-section-title Personal Information
          .form-group
            label(for="name") Full Name
            input#name(type="text" name="name" value=user.name required)

          .form-group
            label(for="email_display") Email
            input#email_display(type="email" value=user.email disabled)
            p.form-hint Email cannot be changed. Go to Settings to manage account.

          .form-group
            label(for="bio") Bio
            textarea#bio(name="bio" rows="3" placeholder="Tell the community about yourself...")= user.bio || ''

          .form-row
            .form-group.form-half
              label(for="phone") Phone Number
              input#phone(type="tel" name="phone" value=user.phone || '' placeholder="e.g. 07123 456789")
            .form-group.form-half
              label(for="date_of_birth") Date of Birth
              input#date_of_birth(type="date" name="date_of_birth" value=(user.date_of_birth ? new Date(user.date_of_birth).toISOString().split('T')[0] : ''))

          .form-group
            label(for="address") Address
            textarea#address(name="address" rows="2" placeholder="Your address (optional)")= user.address || ''

          .form-group
            label(for="location") City / Area
            input#location(type="text" name="location" value=user.location || '' placeholder="e.g. London")

          h3.form-section-title Size & Personalisation
          p.form-section-desc These help match outfits to your size.

          .form-row
            .form-group.form-half
              label(for="height") Height (cm)
              input#height(type="number" name="height" value=user.height || '' placeholder="e.g. 170")
            .form-group.form-half
              label(for="weight") Weight (kg)
              input#weight(type="number" name="weight" value=user.weight || '' placeholder="e.g. 65")

          .form-row
            .form-group.form-half
              label(for="age") Age
              input#age(type="number" name="age" value=user.age || '' placeholder="e.g. 25")
            .form-group.form-half
              label(for="clothing_size") Clothing Size
              select#clothing_size(name="clothing_size")
                option(value="") Not specified
                each s in ['XS', 'S', 'M', 'L', 'XL', 'XXL']
                  option(value=s selected=(user.clothing_size === s))= s

          .form-actions
            button.btn.btn-primary(type="submit") Save Profile
            a.btn.btn-secondary(href=`/users/${user.user_id}`) Cancel
            a.btn.btn-secondary(href="/settings") Account Settings
