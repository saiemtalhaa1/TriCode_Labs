extends layout

block content
  section.section
    .container
      h1.page-title Borrow Dashboard
      p.page-subtitle Track all your borrow requests in one place.

      .dashboard-grid
        //- Pending Requests
        .dashboard-column
          h2.column-title Pending Requests
          if pending.length > 0
            each item in pending
              .dash-card
                .dash-card-header
                  span.dash-item-title #{item.title} #{item.size}
                  span.dash-status.status-pending Pending
                .dash-card-body
                  p.dash-meta Lender: #{item.lender_name}
                  p.dash-meta Dates: #{new Date(item.start_date).toLocaleDateString('en-GB')} - #{new Date(item.end_date).toLocaleDateString('en-GB')}
                .dash-card-actions
                  form(method="POST" action=`/borrow/${item.request_id}/cancel`)
                    button.btn.btn-danger.btn-small(type="submit") Cancel Request
          else
            p.empty-text No pending requests.

        //- Approved
        .dashboard-column
          h2.column-title Approved
          if approved.length > 0
            each item in approved
              .dash-card
                .dash-card-header
                  span.dash-item-title #{item.title} #{item.size}
                  span.dash-status.status-approved Approved
                .dash-card-body
                  p.dash-meta Lender: #{item.lender_name}
                  p.dash-meta Pickup: #{new Date(item.start_date).toLocaleDateString('en-GB')}
                .dash-card-actions
                  a.btn.btn-primary.btn-small(href=`/listings/${item.listing_id}`) View Listing
          else
            p.empty-text No approved requests.

        //- Active
        .dashboard-column
          h2.column-title Active
          if active.length > 0
            each item in active
              .dash-card
                .dash-card-header
                  span.dash-item-title #{item.title} #{item.size}
                  span.dash-status.status-active Active
                .dash-card-body
                  p.dash-meta Lender: #{item.lender_name}
                  p.dash-meta Return: #{new Date(item.end_date).toLocaleDateString('en-GB')}
          else
            p.empty-text No active borrows.

        //- Completed
        .dashboard-column
          h2.column-title Completed
          if completed.length > 0
            each item in completed
              .dash-card
                .dash-card-header
                  span.dash-item-title #{item.title} #{item.size}
                  span.dash-status.status-completed Completed
                .dash-card-body
                  p.dash-meta Lender: #{item.lender_name}
                .dash-card-actions
                  if !item.has_review
                    a.btn.btn-primary.btn-small(href=`/listings/${item.listing_id}`) Leave Review
                  else
                    span.dash-meta Reviewed ✓
          else
            p.empty-text No completed borrows yet.
