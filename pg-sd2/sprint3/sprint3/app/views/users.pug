extends layout

block content
  section.section
    .container
      h1.page-title Community Members
      p.page-subtitle Meet the people sharing outfits in your community.

      .users-grid
        each user in users
          .user-card
            .user-avatar
              if user.profile_image
                img.avatar-img(src=user.profile_image alt=user.name)
              else
                .avatar-placeholder= user.name.charAt(0)
            .user-info
              h3
                a(href=`/users/${user.user_id}`)= user.name
              if user.location
                p.user-location= user.location
              if user.bio
                p.user-bio= user.bio.length > 80 ? user.bio.substring(0, 80) + '...' : user.bio
              .user-stats-row
                .user-stat
                  span.user-stat-value= user.listing_count
                  span.user-stat-label Listings
                .user-stat
                  span.user-stat-value= user.borrow_count
                  span.user-stat-label Borrowed
                .user-stat
                  span.user-stat-value= user.reward_points
                  span.user-stat-label Points
              .user-ratings
                .rating-badge
                  span Borrow: 
                  span.stars= user.borrow_rating ? user.borrow_rating.toFixed(1) + ' ★' : 'N/A'
                .rating-badge
                  span Lend: 
                  span.stars= user.lend_rating ? user.lend_rating.toFixed(1) + ' ★' : 'N/A'
              a.btn.btn-small(href=`/users/${user.user_id}`) View Profile
