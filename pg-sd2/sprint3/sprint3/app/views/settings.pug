extends layout

block content
  section.section
    .container
      h1.page-title Account Settings
      p.page-subtitle Manage your password and privacy preferences.

      if error
        .alert.alert-error= error
      if success
        .alert.alert-success= success

      .settings-layout
        //- Change Password
        .settings-card
          h2.settings-card-title Change Password
          form(method="POST" action="/settings/password")
            .form-group
              label(for="current_password") Current Password
              input#current_password(type="password" name="current_password" required)
            .form-group
              label(for="new_password") New Password
              input#new_password(type="password" name="new_password" required minlength="6" placeholder="Min 6 characters")
            .form-group
              label(for="confirm_password") Confirm New Password
              input#confirm_password(type="password" name="confirm_password" required)
            button.btn.btn-primary(type="submit") Update Password

        //- Privacy Settings
        .settings-card
          h2.settings-card-title Privacy Settings
          p.settings-desc Choose what information is visible to other users on your profile.
          form(method="POST" action="/settings/privacy")
            .privacy-options
              label.privacy-toggle
                input(type="checkbox" name="privacy_email" value="1" checked=user.privacy_email)
                .toggle-switch
                span Show email on profile
              label.privacy-toggle
                input(type="checkbox" name="privacy_phone" value="1" checked=user.privacy_phone)
                .toggle-switch
                span Show phone number on profile
              label.privacy-toggle
                input(type="checkbox" name="privacy_age" value="1" checked=user.privacy_age)
                .toggle-switch
                span Show age on profile
              label.privacy-toggle
                input(type="checkbox" name="privacy_location" value="1" checked=user.privacy_location)
                .toggle-switch
                span Show location on profile
            button.btn.btn-primary(type="submit") Save Privacy Settings

        //- Account Info
        .settings-card
          h2.settings-card-title Account Information
          .settings-info-row
            span.settings-label Email
            span.settings-value= user.email
          .settings-info-row
            span.settings-label Member Since
            span.settings-value= new Date(user.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
          .settings-info-row
            span.settings-label Role
            span.settings-value= user.role.charAt(0).toUpperCase() + user.role.slice(1)
          .settings-info-row
            span.settings-label Reward Points
            span.settings-value= user.reward_points
