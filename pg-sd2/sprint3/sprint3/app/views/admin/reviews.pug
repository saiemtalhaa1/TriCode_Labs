extends ../layout

block content
  section.section
    .container
      .page-header-row
        div
          h1.page-title Manage Reviews
          p.page-subtitle Moderate user reviews across the platform.
        a.btn.btn-secondary(href="/admin") Back to Dashboard

      .admin-table
        each review in reviews
          .admin-row
            .admin-row-main
              div
                span.admin-row-title= '★'.repeat(review.rating) + '☆'.repeat(5 - review.rating) + ' — ' + review.listing_title
                span.admin-row-meta By #{review.reviewer_name} | #{new Date(review.created_at).toLocaleDateString('en-GB')}
                if review.comment
                  p.admin-row-comment "#{review.comment}"
            .admin-row-actions
              a.btn.btn-small(href=`/listings/${review.listing_id}`) View Listing
              form.inline-form(method="POST" action=`/admin/reviews/${review.review_id}/remove` onsubmit="return confirm('Remove this review?')")
                button.btn.btn-small.btn-danger(type="submit") Remove
