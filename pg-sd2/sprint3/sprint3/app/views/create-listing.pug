extends layout

block content
  section.section
    .container
      h1.page-title Create Listing
      p.page-subtitle Share an outfit with the community.

      if error
        .alert.alert-error= error

      .create-layout
        form.create-form(method="POST" action="/create-listing" enctype="multipart/form-data")
          .form-group
            label(for="title") Title
            input#title(type="text" name="title" placeholder="e.g. Summer Blazer M" required)

          .form-group
            label(for="description") Description
            textarea#description(name="description" rows="4" placeholder="Describe the item, condition, material, and any details..." required)

          .form-row
            .form-group.form-half
              label(for="size") Size
              select#size(name="size" required)
                option(value="") Select Size...
                each s in ['XS', 'S', 'M', 'L', 'XL', 'XXL', 'One Size']
                  option(value=s)= s
            .form-group.form-half
              label(for="listing_type") Listing Type
              .radio-group
                label.radio-label
                  input(type="radio" name="listing_type" value="Borrow" checked)
                  span Borrow
                label.radio-label
                  input(type="radio" name="listing_type" value="Giveaway")
                  span Giveaway

          .form-group
            label(for="image") Outfit Image
            .file-upload
              input#image(type="file" name="image" accept="image/*")
              p.form-hint Upload a clear photo of the outfit (max 5MB)

          .form-group
            label(for="location") Location
            input#location(type="text" name="location" placeholder="e.g. London")

          .form-group
            label Categories / Tags
            .checkbox-group
              each tag in tags
                label.checkbox-label
                  input(type="checkbox" name="tags" value=tag.tag_id)
                  span= tag.name

          .form-row
            .form-group.form-half
              label(for="start_date") Available From
              input#start_date(type="date" name="start_date" required)
            .form-group.form-half
              label(for="end_date") Available Until
              input#end_date(type="date" name="end_date" required)
          p.form-hint After this date, the listing will show as expired and no new requests can be made.

          .form-group
            label.checkbox-label
              input(type="checkbox" name="allow_guests" value="1")
              span Allow Guest Borrowers

          button.btn.btn-primary.btn-full(type="submit") Publish Listing
