extends layout

block content
    .container
        h1 Community Members

        //- Debug line to check data in the console (from lab)
        - console.log(data)

        //- Show all users in a table like the lab example
        table(border=1)
            //- Table header row
            tr
                th ID
                th Name
                th Email
                th Location
                th Clothing Size
                th Points
                th Profile

            //- Loop through each user and create a row
            for item in data
                tr
                    td #{item.user_id}
                    td #{item.name}
                    td #{item.email}
                    td #{item.location}
                    td #{item.clothing_size}
                    td #{item.reward_points}
                    td
                        //- Link to the single user page (like the student link from lab)
                        a(href='/users/' + item.user_id) View Profile
