extends layout

block content
    .container
        //- Profile header with image and info
        .profile-header
            img(src=user.profile_image alt=user.name class="profile-img-large")
            .profile-info
                h1 #{user.name}
                p
                    strong Email: 
                    | #{user.email}
                p
                    strong Location: 
                    | #{user.location}
                p
                    strong Clothing Size: 
                    | #{user.clothing_size}
                p
                    strong Bio: 
                    | #{user.bio}
                p
                    strong Reward Points: 
                    | #{user.reward_points}

        //- Show the listings that belong to this user
        h2 Listings by #{user.name}

        if listings.length > 0
            .card-grid
                for item in listings
                    .outfit-card
                        img(src=item.image_url alt=item.title)
                        .card-body
                            h3 #{item.title}
                            p Size: #{item.size}
                            p #{item.location}
                            a.btn(href='/listings/' + item.listing_id) View Listing
        else
            p This user has no listings yet.

        p
            a(href="/users") Back to all users
