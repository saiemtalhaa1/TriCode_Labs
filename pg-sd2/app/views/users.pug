extends layout

block content
    .container
        h1 Community Members
        p Meet the people sharing outfits in our community.

        //- Debug line to check data in the console
        - console.log(data)

        //- Show all users as cards with their profile image
        .user-grid
            for item in data
                .user-card
                    img(src=item.profile_image alt=item.name class="profile-img")
                    h3 #{item.name}
                    p Location: #{item.location}
                    p Size: #{item.clothing_size}
                    p Points: #{item.reward_points}
                    a.btn(href='/users/' + item.user_id) View Profile
