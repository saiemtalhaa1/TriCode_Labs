extends layout

block content
    .container
        h1 Browse by Category
        p See outfits organised by category.

        //- Loop through each tag and show its listings underneath
        for tag in tags
            .category-section
                h2 #{tag.name}
                p #{tag.description}

                //- Check if there are any listings in this tag
                if grouped[tag.name].length > 0
                    .card-grid
                        each item in grouped[tag.name]
                            .outfit-card
                                img(src=item.image_url alt=item.title)
                                .card-body
                                    h3 #{item.title}
                                    p Size: #{item.size}
                                    p By: #{item.owner_name}
                                    a.btn(href='/listings/' + item.listing_id) View
                else
                    p No outfits in this category yet.
