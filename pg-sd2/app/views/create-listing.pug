extends layout

block content
    .container
        .form-box
            h1 Create New Listing
            p Share an outfit with the community.

            //- Create listing form - uses POST method like the lab
            form(action="/create-listing" method="POST")
                div
                    label(for="title") Title
                    input(type="text" name="title" id="title" required placeholder="e.g. Summer Blazer")
                div
                    label(for="description") Description
                    textarea(name="description" id="description" required placeholder="Describe the outfit")
                div
                    label(for="size") Size
                    select(name="size" id="size" required)
                        option(value="XS") XS
                        option(value="S") S
                        option(value="M") M
                        option(value="L") L
                        option(value="XL") XL
                        option(value="One Size") One Size
                div
                    label(for="location") Location
                    input(type="text" name="location" id="location" required placeholder="e.g. London")
                div
                    label(for="image_url") Image URL
                    input(type="text" name="image_url" id="image_url" placeholder="https://...")
                    p.form-help Paste a URL of an image of your outfit.
                div
                    input(type="submit" value="Create Listing")

            p
                a(href="/my-listings") Back to My Listings