extends layout

block content
    .container
        h1 My Borrow Requests
        p Track the outfits you have requested to borrow.

        //- Debug line
        - console.log(data)

        if data.length > 0
            .card-grid
                for item in data
                    .outfit-card
                        img(src=item.image_url alt=item.title)
                        .card-body
                            h3 #{item.title}
                            p Size: #{item.size}
                            p Owner: #{item.owner_name}
                            p Dates: #{item.start_date} to #{item.end_date}
                            p 
                                strong Status: 
                                span(class="status-" + item.status.toLowerCase())= item.status
            p You haven't requested any outfits yet.
            p
                a.btn(href="/listings") Browse outfits to borrow
