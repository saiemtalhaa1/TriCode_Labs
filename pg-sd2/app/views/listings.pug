extends layout

block content
    .container
        h1 Browse Outfits
        p Find outfits available to borrow from the community.

        //- Debug line to check data in the console
        - console.log(data)

        //- Show all listings as cards with images
        .card-grid
            for item in data
                .outfit-card
                    img(src=item.image_url alt=item.title)
                    .card-body
                        h3 #{item.title}
                        p #{item.description}
                        p Size: #{item.size}
                        p Location: #{item.location}
                        p Listed by: #{item.owner_name}
                        a.btn(href='/listings/' + item.listing_id) View Details
